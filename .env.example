# Server-side only (Vercel Project Settings -> Environment Variables).
# Never prefix these with VITE_ - that would bundle them into the client build.
ANTHROPIC_API_KEY=
# Optional: shared secret the Talk chat endpoint checks against. Leave both
# this and VITE_CHAT_ACCESS_KEY below empty to skip the check entirely.
CHAT_ACCESS_KEY=

# Client-side (must match CHAT_ACCESS_KEY above if you set one). Safe to be
# public - it's bundled into the shipped JS, so it's a light deterrent
# against a stray URL being called, not real authentication.
VITE_CHAT_ACCESS_KEY=
